# Public URL of the site, no trailing slash (used for SEO, sitemap and Stripe redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# Postgres (Railway sets this when you add a Postgres database and reference it)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/printpipe

# Random string, at least 32 characters
AUTH_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# Your Gotenberg instance. On Railway use the private URL: http://gotenberg.railway.internal:3000
GOTENBERG_URL=https://gotenberg-production-6f9c.up.railway.app
# Only if you turn on basic auth in Gotenberg
GOTENBERG_USERNAME=
GOTENBERG_PASSWORD=

# Stripe (Dashboard -> Developers -> API keys / Webhooks)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Printed by `npm run stripe:setup`
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...

# Google Analytics 4 and Google Ads (optional, leave empty to disable tracking)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_ADS_SIGNUP_LABEL=
NEXT_PUBLIC_ADS_PURCHASE_LABEL=
