{
  "name": "printpipe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "prisma migrate deploy && next start -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "stripe:setup": "node scripts/stripe-setup.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcryptjs": "3.0.2",
    "jose": "6.1.0",
    "next": "15.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "stripe": "18.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "prisma": "6.19.0",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.2"
  }
}
